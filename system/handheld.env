# Copied to /etc/handheld/handheld.env by install.sh
HANDHELD_PORT=7777
HANDHELD_HOST=127.0.0.1
HANDHELD_POLL_MS=5000
HANDHELD_SHELL_DIR=/opt/handheld/apps/shell/dist
# cog platform plugin: drm (no compositor), wl (under a Wayland compositor)
COG_PLATFORM=drm
# Spotify app Client ID (developer.spotify.com/dashboard). PKCE, so no secret.
# Register the redirect URI http://127.0.0.1:7777/api/spotify/callback on the app.
#SPOTIFY_CLIENT_ID=
