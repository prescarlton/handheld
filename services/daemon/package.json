{
  "name": "@handheld/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HANDHELD_MOCK=1 tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/daemon.js",
    "start": "node dist/daemon.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@handheld/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
